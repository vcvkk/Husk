# exteraGram on the macOS test host (.github/workflows/extera.yml). The APK is not in the repository: the job takes it from
# Google Drive by its id (DRIVE_ID), compiles it on the boot image of a run of "ART runtime on Darwin" (RUN_ID), and runs it.
RUN_ID=43230160430
DRIVE_ID=1E5hod2wD8X5B_pCFLx81UNaLTbulGy1i
SECONDS=45
HOST_ARGS=--insets 0,177,0,102
PROFILE_AT=
SCRIPT=tests/extera.script
NOJIT=1
HUSK_PREFS=exteraconfig:pluginsEngine=true,systemConfig:logsEnabled=true
CRASH_HOOK=0
HUSK_DUMP_VIEWS=13,33
HUSK_RENDERNODE_TRACE=1
DUMP_NINEPATCH=1
IPA_VM_OPTIONS=env:HUSK_FRAME_STATS=1 env:HUSK_LOG_TIME=1 env:HUSK_PREFS=systemConfig:logsEnabled=true
HUSK_INSETS_TRACE=1
HUSK_DEBUG_SQL=10|SELECT did, unread_count, top_message, inbox_max, outbox_max FROM dialogs ORDER BY date DESC LIMIT 20|SELECT uid, COUNT(*), SUM(read_state IN(0,2)), min(mid), max(mid) FROM messages_v2 GROUP BY uid LIMIT 20
