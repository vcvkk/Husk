# exteraGram on the macOS test host (.github/workflows/extera.yml). The APK is not in the repository: the job takes it from
# Google Drive by its id (DRIVE_ID), compiles it on the boot image of a run of "ART runtime on Darwin" (RUN_ID), and runs it.
RUN_ID=43178921822
DRIVE_ID=1E5hod2wD8X5B_pCFLx81UNaLTbulGy1i
SECONDS=45
HOST_ARGS=--insets 0,177,0,102
PROFILE_AT=
SCRIPT=tests/extera.script
NOJIT=1
HUSK_PREFS=exteraconfig:pluginsEngine=true,systemConfig:logsEnabled=true
CRASH_HOOK=0
HUSK_DUMP_VIEWS=13,33
HUSK_RENDERNODE_TRACE=1
DUMP_NINEPATCH=1
IPA_VM_OPTIONS=env:HUSK_FRAME_STATS=1 env:HUSK_LOG_TIME=1 env:HUSK_PREFS=systemConfig:logsEnabled=true
HUSK_INSETS_TRACE=1
HUSK_DEBUG_SQL=14|SELECT sqlite_version()|PRAGMA journal_mode|PRAGMA mmap_size|SELECT COUNT(*) FROM sqlite_master|SELECT COUNT(*) FROM messages_v2|SELECT COUNT(*) FROM messages_v2 WHERE read_state IN(0,2)|SELECT max(mid), max(date) FROM messages_v2 WHERE uid = 1 AND read_state IN(0,2)|CREATE TEMP TABLE husk_t(a INTEGER PRIMARY KEY, b INTEGER, c INTEGER)|INSERT INTO husk_t VALUES(1,0,5),(2,1,5),(3,2,5),(4,0,6),(5,3,5)|CREATE INDEX husk_i ON husk_t(c, b)|SELECT COUNT(*) FROM husk_t|SELECT COUNT(*) FROM husk_t WHERE b IN(0,2)|SELECT COUNT(*) FROM husk_t WHERE c = 5 AND b IN(0,2)|SELECT max(a), min(a) FROM husk_t WHERE c = 5 AND b IN(0,2)|SELECT a FROM husk_t WHERE c = 5 AND b IN(0,2) ORDER BY a DESC|SELECT COUNT(*) FROM husk_t WHERE c = 7|SELECT max(a) FROM husk_t WHERE c = 7
