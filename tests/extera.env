# exteraGram on the macOS test host (.github/workflows/extera.yml). The APK is not in the repository: the job takes it from
# Google Drive by its id (DRIVE_ID), compiles it on the boot image of a run of "ART runtime on Darwin" (RUN_ID), and runs it.
RUN_ID=41124476746
DRIVE_ID=1E5hod2wD8X5B_pCFLx81UNaLTbulGy1i
SECONDS=25
HOST_ARGS=--burst 16
PROFILE_AT=20
NOJIT=1
HUSK_DEBUG_INVOKE=12|com.exteragram.messenger.adblock.interop.NativeAdBlock#loadLibraries|com.exteragram.messenger.adblock.interop.NativeAdBlock#createFilterSet:a=/banner/,/ads/|com.exteragram.messenger.adblock.interop.NativeAdBlock#addFilters:$:s=/promo/|com.exteragram.messenger.adblock.interop.NativeAdBlock#createEngine:$
