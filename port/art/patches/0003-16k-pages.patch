 // Required stack alignment
 static constexpr size_t kStackAlignment = 16;
 
-// System page size. We check this against sysconf(_SC_PAGE_SIZE) at runtime, but use a simple
-// compile-time constant so the compiler can generate better code.
-static constexpr int kPageSize = 4096;
+// Page size the runtime lays memory and files out in, a compile-time constant so the compiler
+// can generate better code. 16 KiB, the page of Apple's arm64 hardware (macOS, iOS), and a
+// multiple of 4 KiB, so the same layout holds where pages are 4 KiB: a boot image or oat file
+// that dex2oat writes on Linux is laid out as the runtime on Darwin needs it. The runtime
+// checks at start that the system's page divides it.
+static constexpr int kPageSize = 16384;
+
+// Alignment of the segments of ELF files the compiler writes (oat files). Apple's
+// arm64 hardware protects memory in 16 KiB pages, so an oat file whose code and
+// writable data are to be mapped there -- as a Mach-O dylib, by husk-port -- must
+// not share a 16 KiB page between them. A multiple of kPageSize, so these files
+// still load where pages are 4 KiB. (Later ART versions have the same constant.)
+static constexpr size_t kElfSegmentAlignment = 16384;
 
