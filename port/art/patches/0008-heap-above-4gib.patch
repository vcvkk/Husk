@@ -56,6 +56,47 @@ static inline int futex(volatile int *uaddr, int op, int val, const struct times
 }
 #endif  // ART_USE_FUTEXES
 
+#if !ART_USE_FUTEXES && defined(__APPLE__)
+// Darwin's futex is __ulock_wait/__ulock_wake (libsystem_kernel; what its pthread mutexes and
+// os_unfair_lock are built on). Enough of futex(2) for Thread::Park/Unpark: wait (until a
+// relative time, or an absolute realtime deadline) and wake.
+extern "C" int __ulock_wait(uint32_t operation, void* addr, uint64_t value, uint32_t timeout_us);
+extern "C" int __ulock_wake(uint32_t operation, void* addr, uint64_t wake_value);
+#define ART_DARWIN_FUTEX 1
+#define FUTEX_WAIT_PRIVATE 128
+#define FUTEX_WAKE_PRIVATE 129
+#define FUTEX_WAIT_BITSET_PRIVATE 137
+#define FUTEX_CLOCK_REALTIME 256
+#define FUTEX_BITSET_MATCH_ANY 0xffffffff
+static inline int futex(volatile int *uaddr, int op, int val, const struct timespec *timeout,
+                        volatile int *uaddr2 ATTRIBUTE_UNUSED, int val3 ATTRIBUTE_UNUSED) {
+  constexpr uint32_t kCompareAndWait = 1;  // UL_COMPARE_AND_WAIT
+  constexpr uint32_t kWakeAll = 0x100;     // ULF_WAKE_ALL
+  void* addr = const_cast<int*>(uaddr);
+  if (op == FUTEX_WAKE_PRIVATE) {
+    int r = __ulock_wake(kCompareAndWait | (val > 1 ? kWakeAll : 0u), addr, 0);
+    return (r == -1 && errno == ENOENT) ? 0 : r;  // no waiter is not an error
+  }
+  uint32_t timeout_us = 0;  // 0: no timeout
+  if (timeout != nullptr) {
+    int64_t ns = static_cast<int64_t>(timeout->tv_sec) * 1000000000 + timeout->tv_nsec;
+    if ((op & ~FUTEX_CLOCK_REALTIME) == FUTEX_WAIT_BITSET_PRIVATE) {  // an absolute deadline
+      timespec now;
+      clock_gettime(CLOCK_REALTIME, &now);
+      ns -= static_cast<int64_t>(now.tv_sec) * 1000000000 + now.tv_nsec;
+    }
+    if (ns <= 0) {
+      errno = ETIMEDOUT;
+      return -1;
+    }
+    int64_t us = (ns + 999) / 1000;
+    timeout_us = us > UINT32_MAX ? UINT32_MAX : static_cast<uint32_t>(us);
+  }
+  int r = __ulock_wait(kCompareAndWait, addr, static_cast<uint32_t>(val), timeout_us);
+  return r < 0 ? -1 : 0;
+}
+#endif  // !ART_USE_FUTEXES && __APPLE__
+
 // The following isn't strictly necessary, but we want updates on Atomic<pid_t> to be lock-free.
 // TODO: Use std::atomic::is_always_lock_free after switching to C++17 atomics.
 static_assert(sizeof(pid_t) <= sizeof(int32_t), "pid_t should fit in 32 bits");
