@@ -282,6 +282,25 @@ void UContext::Dump(std::ostream& os) const {
   DumpRegister64(os, "pstate", context.pstate);
   DumpArmStatusRegister(os, context.pstate);
   os << '\n';
+#elif defined(__APPLE__) && defined(__aarch64__)
+  for (size_t i = 0; i <= 28; ++i) {
+    std::string reg_name = "x" + std::to_string(i);
+    DumpRegister64(os, reg_name.c_str(), context->__ss.__x[i]);
+    if (i % 4 == 3) {
+      os << '\n';
+    }
+  }
+  DumpRegister64(os, "fp", __darwin_arm_thread_state64_get_fp(context->__ss));
+  DumpRegister64(os, "lr", __darwin_arm_thread_state64_get_lr(context->__ss));
+  os << '\n';
+
+  DumpRegister64(os, "sp", __darwin_arm_thread_state64_get_sp(context->__ss));
+  DumpRegister64(os, "pc", __darwin_arm_thread_state64_get_pc(context->__ss));
+  os << '\n';
+
+  DumpRegister64(os, "cpsr", context->__ss.__cpsr);
+  DumpArmStatusRegister(os, context->__ss.__cpsr);
+  os << '\n';
 #else
   // TODO: Add support for MIPS32 and MIPS64.
   os << "Unknown architecture/word size/OS in ucontext dump";
