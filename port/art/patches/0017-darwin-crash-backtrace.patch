+}  // namespace art
+
+#include <cinttypes>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <string.h>
+#include <sys/ucontext.h>
+
+#include "android-base/stringprintf.h"
+#include "base/utils.h"
+
+namespace art {
+
+using android::base::StringPrintf;
+
+// Husk: who names an address in a library the host's own loader mapped (an Android .so: dladdr knows only its dylib, if any).
+static const char* (*g_husk_crash_describer)(uintptr_t pc, char* buf, size_t len) = nullptr;
+
+static void DumpDarwinFrame(std::ostream& os, const char* prefix, size_t i, uintptr_t pc) {
+  char guest[256];
+  const char* g = g_husk_crash_describer != nullptr ? g_husk_crash_describer(pc, guest, sizeof(guest)) : nullptr;
+  Dl_info info = {};
+  os << prefix << StringPrintf("#%02zu pc %016" PRIxPTR "  ", i, pc);
+  if (g != nullptr) {
+    os << g;
+  } else if (dladdr(reinterpret_cast<void*>(pc), &info) != 0 && info.dli_fname != nullptr) {
+    const char* base = strrchr(info.dli_fname, '/');
+    os << (base != nullptr ? base + 1 : info.dli_fname);
+    if (info.dli_sname != nullptr) {
+      os << " (" << info.dli_sname << "+" << (pc - reinterpret_cast<uintptr_t>(info.dli_saddr)) << ")";
+    } else {
+      os << StringPrintf(" +%#" PRIxPTR, pc - reinterpret_cast<uintptr_t>(info.dli_fbase));
+    }
+  } else {
+    os << "?";
+  }
+  os << std::endl;
+}
+
+// The calling thread's frames, by its frame records (arm64 code keeps x29 chained, Apple's and Android's both): from a signal's
+// context when there is one. Other threads' stacks are not walked.
+void DumpNativeStack(std::ostream& os,
+                     pid_t tid,
                      BacktraceMap* existing_map ATTRIBUTE_UNUSED,
-                     const char* prefix ATTRIBUTE_UNUSED,
+                     const char* prefix,
                      ArtMethod* current_method ATTRIBUTE_UNUSED,
-                     void* ucontext_ptr ATTRIBUTE_UNUSED,
+                     void* ucontext_ptr,
                      bool skip_frames ATTRIBUTE_UNUSED) {
+#if defined(__aarch64__)
+  uintptr_t pc, lr, fp;
+  if (ucontext_ptr != nullptr) {
+    const ucontext_t* uc = reinterpret_cast<const ucontext_t*>(ucontext_ptr);
+    pc = static_cast<uintptr_t>(__darwin_arm_thread_state64_get_pc(uc->uc_mcontext->__ss));
+    lr = static_cast<uintptr_t>(__darwin_arm_thread_state64_get_lr(uc->uc_mcontext->__ss));
+    fp = static_cast<uintptr_t>(__darwin_arm_thread_state64_get_fp(uc->uc_mcontext->__ss));
+  } else if (tid == GetTid()) {
+    pc = reinterpret_cast<uintptr_t>(&DumpNativeStack);
+    lr = 0;
+    fp = reinterpret_cast<uintptr_t>(__builtin_frame_address(0));
+  } else {
+    return;
+  }
+  pthread_t self = pthread_self();
+  uintptr_t hi = reinterpret_cast<uintptr_t>(pthread_get_stackaddr_np(self));
+  uintptr_t lo = hi - pthread_get_stacksize_np(self);
+  size_t n = 0;
+  DumpDarwinFrame(os, prefix, n++, pc);
+  if (lr != 0) {
+    DumpDarwinFrame(os, prefix, n++, lr & 0x0000ffffffffffffull);
+  }
+  for (; n < 64 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; ) {
+    const uintptr_t* rec = reinterpret_cast<const uintptr_t*>(fp);
+    uintptr_t next = rec[0], ret = rec[1] & 0x0000ffffffffffffull;
+    if (ret == 0) break;
+    if (n != 2 || ret != (lr & 0x0000ffffffffffffull)) DumpDarwinFrame(os, prefix, n++, ret);
+    if (next <= fp) break;
+    fp = next;
+  }
+#else
+  UNUSED(os, tid, prefix, ucontext_ptr);
+#endif
+}
+
+extern "C" __attribute__((visibility("default"), used)) void art_husk_set_crash_describer(
+    const char* (*fn)(uintptr_t pc, char* buf, size_t len)) {
+  g_husk_crash_describer = fn;
 }
 
 void DumpKernelStack(std::ostream& os ATTRIBUTE_UNUSED,
diff --git a/art/runtime/runtime_common.cc b/art/runtime/runtime_common.cc
