 namespace art {
 
+#if defined(__APPLE__)
+// zero in both return registers, so any return type reads as 0, false, 0.0 or null
+#if defined(__aarch64__)
+extern "C" void art_husk_missing_native();
+asm(".text\n.globl _art_husk_missing_native\n.p2align 2\n_art_husk_missing_native:\n  mov x0, #0\n  fmov d0, xzr\n  ret\n");
+#else
+extern "C" uint64_t art_husk_missing_native() { return 0; }
+#endif
+#endif
+
 // Used by the JNI dlsym stub to find the native method to invoke if none is registered.
 #if defined(__arm__) || defined(__aarch64__)
 extern "C" const void* artFindNativeMethod() {
@@ -42,6 +52,15 @@ extern "C" const void* artFindNativeMethod(Thread* self) {
   // Lookup symbol address for method, on failure we'll return null with an exception set,
   // otherwise we return the address of the method we found.
   void* native_code = soa.Vm()->FindCodeForNativeMethod(method);
+#if defined(__APPLE__)
+  if (native_code == nullptr && !method->GetDeclaringClass()->GetClassLoader().IsNull()) {
+    // husk-port: an app's native method whose library is not here (an Android .so, which Darwin can not load): it
+    // returns zero, false or null, whatever its signature, instead of throwing, as libcore's loadLibrary went on.
+    self->ClearException();
+    LOG(WARNING) << "husk-port: no native code for " << method->PrettyMethod() << ", it returns nothing";
+    native_code = reinterpret_cast<void*>(art_husk_missing_native);
+  }
+#endif
   if (native_code == nullptr) {
     self->AssertPendingException();
     return nullptr;
