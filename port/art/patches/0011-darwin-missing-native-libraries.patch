+#if defined(__APPLE__)
+  if (native_code == nullptr && !method->GetDeclaringClass()->GetClassLoader().IsNull()) {
+    // husk-port: an app's native method whose library is not here (an Android .so, which Darwin can not load): it
+    // returns zero or false (an object: an empty one of its type), instead of throwing, as libcore's loadLibrary went on.
+    self->ClearException();
+    LOG(WARNING) << "husk-port: no native code for " << method->PrettyMethod() << ", it returns nothing";
+    char ret = method->GetShorty()[0];
+    native_code = ret == 'L' ? reinterpret_cast<void*>(art_husk_missing_object)
+                             : reinterpret_cast<void*>(art_husk_missing_native);
+  }
+#endif
   if (native_code == nullptr) {
     self->AssertPendingException();
     return nullptr;
