+// ---- Husk: the hooks' JNI side, LSPlant's calls as exteraGram's JniBridgeBindings declares them (art_husk_hook_natives)
+static jobject HuskHook0(JNIEnv* env, jclass, jobject hooker, jobject target, jobject callback) {
+  ScopedObjectAccess soa(env);
+  Thread* self = soa.Self();
+  if (hooker == nullptr || target == nullptr || callback == nullptr) {
+    return nullptr;
+  }
+  ArtMethod* method = ArtMethod::FromReflectedMethod(soa, target);
+  ArtMethod* cb = ArtMethod::FromReflectedMethod(soa, callback);
+  if (method == nullptr || cb == nullptr || method->IsNative() || method->IsAbstract() || method->IsProxyMethod() ||
+      method->IsIntrinsic()) {
+    LOG(WARNING) << "husk hook: cannot hook " << (method != nullptr ? method->PrettyMethod() : "null");
+    return nullptr;
+  }
+  {
+    std::lock_guard<std::mutex> l(g_husk_hooks_lock);
+    if (g_husk_hooks->count(method) != 0) {
+      return nullptr;  // hooked already
+    }
+  }
+  ClassLinker* linker = Runtime::Current()->GetClassLinker();
+  if (method->IsStatic()) {
+    // a static method of an uninitialized class still has the resolution stub, and initializing it sets the code again
+    StackHandleScope<1> hs(self);
+    Handle<mirror::Class> klass = hs.NewHandle(method->GetDeclaringClass());
+    if (!linker->EnsureInitialized(self, klass, true, true)) {
+      return nullptr;
+    }
+  }
+  const PointerSize ps = linker->GetImagePointerSize();
+  LengthPrefixedArray<ArtMethod>* array = linker->AllocArtMethodArray(self, Runtime::Current()->GetLinearAlloc(), 1);
+  if (array == nullptr) {
+    return nullptr;
+  }
+  ArtMethod* backup = &array->At(0, ArtMethod::Size(ps), ArtMethod::Alignment(ps));
+  backup->CopyFrom(method, ps);
+  uint32_t flags = backup->GetAccessFlags();
+  flags &= ~(kAccPublic | kAccProtected | kAccConstructor | kAccFastInterpreterToInterpreterInvoke |
+             kAccSingleImplementation | kAccDefault);
+  backup->SetAccessFlags(flags | kAccPrivate);
+  ObjPtr<mirror::Method> reflected = mirror::Method::CreateFromArtMethod<PointerSize::k64, false>(self, backup);
+  if (reflected == nullptr) {
+    return nullptr;
+  }
+  reflected->SetFieldBoolean<false>(mirror::AccessibleObject::FlagOffset(), 1);  // setAccessible(true)
+  jobject result = soa.AddLocalReference<jobject>(reflected);
+  HuskHook hook;
+  hook.hooker = soa.Vm()->AddGlobalRef(self, soa.Decode<mirror::Object>(hooker));
+  hook.callback = cb;
+  hook.backup = backup;
+  hook.entry = method->GetEntryPointFromQuickCompiledCodePtrSize(ps);
+  {
+    std::lock_guard<std::mutex> l(g_husk_hooks_lock);
+    (*g_husk_hooks)[method] = hook;
+    g_husk_any_hook.store(true);
+  }
+  method->SetEntryPointFromQuickCompiledCodePtrSize(GetQuickToInterpreterBridge(), ps);
+  method->ClearFastInterpreterToInterpreterInvokeFlag();
+  VLOG(class_linker) << "husk hook: " << method->PrettyMethod();
+  return result;
+}
+
+static jboolean HuskUnhook0(JNIEnv* env, jclass, jobject target) {
+  ScopedObjectAccess soa(env);
+  ArtMethod* method = target != nullptr ? ArtMethod::FromReflectedMethod(soa, target) : nullptr;
+  HuskHook hook;
+  {
+    std::lock_guard<std::mutex> l(g_husk_hooks_lock);
+    auto it = method != nullptr ? g_husk_hooks->find(method) : g_husk_hooks->end();
+    if (it == g_husk_hooks->end()) {
+      return JNI_FALSE;
+    }
+    hook = it->second;
+    g_husk_hooks->erase(it);
+  }
+  method->SetEntryPointFromQuickCompiledCodePtrSize(hook.entry, Runtime::Current()->GetClassLinker()->GetImagePointerSize());
+  soa.Vm()->DeleteGlobalRef(soa.Self(), hook.hooker);
+  return JNI_TRUE;
+}
+
+static jboolean HuskIsHooked0(JNIEnv* env, jclass, jobject target) {
+  ScopedObjectAccess soa(env);
+  ArtMethod* method = target != nullptr ? ArtMethod::FromReflectedMethod(soa, target) : nullptr;
+  return method != nullptr && HuskIsHooked(method) ? JNI_TRUE : JNI_FALSE;
+}
+
+static jboolean HuskInvokeConstructor0(JNIEnv* env, jclass, jobject receiver, jobject constructor, jobjectArray args) {
+  ScopedObjectAccess soa(env);
+  InvokeMethod(soa, constructor, receiver, args, 1);
+  return soa.Self()->IsExceptionPending() ? JNI_FALSE : JNI_TRUE;
+}
+
+static jobject HuskAllocateInstance0(JNIEnv* env, jclass, jclass cls) {
+  ScopedObjectAccess soa(env);
+  Thread* self = soa.Self();
+  StackHandleScope<1> hs(self);
+  Handle<mirror::Class> klass = hs.NewHandle(soa.Decode<mirror::Class>(cls));
+  if (klass == nullptr || !Runtime::Current()->GetClassLinker()->EnsureInitialized(self, klass, true, true)) {
+    return nullptr;
+  }
+  return soa.AddLocalReference<jobject>(klass->AllocObject(self));
+}
+
+static jboolean HuskMakeClassInheritable0(JNIEnv* env, jclass, jclass cls) {
+  ScopedObjectAccess soa(env);
+  ObjPtr<mirror::Class> klass = soa.Decode<mirror::Class>(cls);
+  if (klass == nullptr) {
+    return JNI_FALSE;
+  }
+  klass->SetAccessFlags(klass->GetAccessFlags() & ~kAccFinal);
+  return JNI_TRUE;
+}
+
+static jboolean HuskDisableHiddenApi0(JNIEnv*, jclass) {
+  Runtime::Current()->SetHiddenApiEnforcementPolicy(hiddenapi::EnforcementPolicy::kDisabled);
+  return JNI_TRUE;
+}
+
+static jboolean HuskTrue0(JNIEnv*, jclass) { return JNI_TRUE; }
+static jboolean HuskDeoptimize0(JNIEnv*, jclass, jobject) { return JNI_TRUE; }   // Husk compiles apps without inlining
+
 }  // namespace interpreter
 }  // namespace art
