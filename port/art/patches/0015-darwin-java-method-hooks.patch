+/*
+ * Husk: Java method hooks without generated code, for apps that hook their own methods the way LSPlant does (exteraGram's
+ * plugins: dev.exterahook.runtime.bridge.JniBridgeBindings). A hooked method's entry point is the interpreter bridge, so every
+ * call to it -- from compiled code, the interpreter, reflection, JNI -- arrives in Execute, which calls the hook's callback
+ * instead: Object callback(Object[] args), args being this (unless static) and the parameters, boxed. The original stays
+ * callable through a copy of its ArtMethod (private, so called directly), handed back as a java.lang.reflect.Method.
+ * Calls compiled inline, or to intrinsics, do not see a hook (Husk compiles apps without inlining).
+ */
+namespace {
+struct HuskHook {
+  jobject hooker;          // a global reference
+  ArtMethod* callback;
+  ArtMethod* backup;
+  const void* entry;       // the method's entry point before
+};
+std::mutex g_husk_hooks_lock;
+std::unordered_map<ArtMethod*, HuskHook>* g_husk_hooks = new std::unordered_map<ArtMethod*, HuskHook>();
+std::atomic<bool> g_husk_any_hook{false};
+}  // namespace
+
+bool HuskIsHooked(ArtMethod* method) {
+  if (LIKELY(!g_husk_any_hook.load(std::memory_order_relaxed))) {
+    return false;
+  }
+  std::lock_guard<std::mutex> l(g_husk_hooks_lock);
+  return g_husk_hooks->count(method) != 0;
+}
+
+static JValue HuskHookDispatch(Thread* self, const CodeItemDataAccessor& accessor, ShadowFrame& shadow_frame)
+    REQUIRES_SHARED(Locks::mutator_lock_) {
+  ArtMethod* method = shadow_frame.GetMethod();
+  HuskHook hook;
+  {
+    std::lock_guard<std::mutex> l(g_husk_hooks_lock);
+    auto it = g_husk_hooks->find(method);
+    if (it == g_husk_hooks->end()) {
+      return JValue();
+    }
+    hook = it->second;
+  }
+  uint32_t shorty_len = 0;
+  const char* shorty = method->GetShorty(&shorty_len);
+  const bool is_static = method->IsStatic();
+  const int32_t nargs = (is_static ? 0 : 1) + static_cast<int32_t>(shorty_len) - 1;
+  StackHandleScope<1> hs(self);
+  Handle<mirror::ObjectArray<mirror::Object>> args = hs.NewHandle(
+      mirror::ObjectArray<mirror::Object>::Alloc(self, GetClassRoot<mirror::ObjectArray<mirror::Object>>(), nargs));
+  if (args == nullptr) {
+    return JValue();  // out of memory, pending
+  }
+  size_t reg = accessor.RegistersSize() - accessor.InsSize();
+  int32_t k = 0;
+  if (!is_static) {
+    args->Set<false>(k++, shadow_frame.GetVRegReference(reg++));
+  }
+  for (uint32_t i = 1; i < shorty_len; ++i) {
+    JValue v;
+    ObjPtr<mirror::Object> o;
+    switch (shorty[i]) {
+      case 'L': case '[': o = shadow_frame.GetVRegReference(reg++); break;
+      case 'J': v.SetJ(shadow_frame.GetVRegLong(reg)); reg += 2; o = BoxPrimitive(Primitive::kPrimLong, v); break;
+      case 'D': v.SetD(shadow_frame.GetVRegDouble(reg)); reg += 2; o = BoxPrimitive(Primitive::kPrimDouble, v); break;
+      case 'F': v.SetF(shadow_frame.GetVRegFloat(reg++)); o = BoxPrimitive(Primitive::kPrimFloat, v); break;
+      case 'Z': v.SetZ(shadow_frame.GetVReg(reg++) != 0); o = BoxPrimitive(Primitive::kPrimBoolean, v); break;
+      case 'B': v.SetB(static_cast<int8_t>(shadow_frame.GetVReg(reg++))); o = BoxPrimitive(Primitive::kPrimByte, v); break;
+      case 'C': v.SetC(static_cast<uint16_t>(shadow_frame.GetVReg(reg++))); o = BoxPrimitive(Primitive::kPrimChar, v); break;
+      case 'S': v.SetS(static_cast<int16_t>(shadow_frame.GetVReg(reg++))); o = BoxPrimitive(Primitive::kPrimShort, v); break;
+      default: v.SetI(shadow_frame.GetVReg(reg++)); o = BoxPrimitive(Primitive::kPrimInt, v); break;
+    }
+    if (self->IsExceptionPending()) {
+      return JValue();
+    }
+    args->Set<false>(k++, o);
+  }
+  JValue result;
+  {
+    ScopedObjectAccessUnchecked soa(self);
+    jvalue jargs[1];
+    jargs[0].l = soa.AddLocalReference<jobject>(args.Get());
+    result = InvokeVirtualOrInterfaceWithJValues(soa, hook.hooker, jni::EncodeArtMethod(hook.callback), jargs);
+    soa.Env()->DeleteLocalRef(jargs[0].l);
+  }
+  if (self->IsExceptionPending()) {
+    return JValue();
+  }
+  const char rt = shorty[0];
+  if (rt == 'V' || rt == 'L' || rt == '[') {
+    return rt == 'V' ? JValue() : result;
+  }
+  JValue unboxed;
+  ObjPtr<mirror::Class> dst = Runtime::Current()->GetClassLinker()->FindPrimitiveClass(rt);
+  if (!UnboxPrimitiveForResult(result.GetL(), dst, &unboxed)) {
+    return JValue();
+  }
+  return unboxed;
+}
