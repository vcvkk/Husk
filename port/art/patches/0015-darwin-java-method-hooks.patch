+extern "C" __attribute__((visibility("default"))) const JNINativeMethod* art_husk_hook_natives(int* count) {
+  using namespace art::interpreter;  // NOLINT
+  static const JNINativeMethod k[] = {
+    { "hook0", "(Ljava/lang/Object;Ljava/lang/reflect/Member;Ljava/lang/reflect/Method;)Ljava/lang/reflect/Method;",
+      reinterpret_cast<void*>(HuskHook0) },
+    { "unhook0", "(Ljava/lang/reflect/Member;)Z", reinterpret_cast<void*>(HuskUnhook0) },
+    { "isHooked0", "(Ljava/lang/reflect/Member;)Z", reinterpret_cast<void*>(HuskIsHooked0) },
+    { "deoptimize0", "(Ljava/lang/reflect/Member;)Z", reinterpret_cast<void*>(HuskDeoptimize0) },
+    { "invokeConstructor0", "(Ljava/lang/Object;Ljava/lang/reflect/Constructor;[Ljava/lang/Object;)Z",
+      reinterpret_cast<void*>(HuskInvokeConstructor0) },
+    { "allocateInstance0", "(Ljava/lang/Class;)Ljava/lang/Object;", reinterpret_cast<void*>(HuskAllocateInstance0) },
+    { "makeClassInheritable0", "(Ljava/lang/Class;)Z", reinterpret_cast<void*>(HuskMakeClassInheritable0) },
+    { "disableHiddenApiRestrictions0", "()Z", reinterpret_cast<void*>(HuskDisableHiddenApi0) },
+    { "disableProfileSaver0", "()Z", reinterpret_cast<void*>(HuskTrue0) },
+    { "initialize0", "()Z", reinterpret_cast<void*>(HuskTrue0) },
+  };
+  *count = static_cast<int>(sizeof(k) / sizeof(k[0]));
+  return k;
+}
