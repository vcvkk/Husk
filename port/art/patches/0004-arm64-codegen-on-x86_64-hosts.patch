+libart-dex2oat-defaults_x86_64_CODEGEN_HOST_LDLIBS = $(if $(filter arm64,$(ART_HOST_CODEGEN_ARCHS)),-lvixl)
 libart-dex2oat-defaults_LDLIBS   =  \
         $(libart-dex2oat-defaults_$(HOST_ARCH)_CODEGEN_HOST_LDLIBS) \
         -lz \
